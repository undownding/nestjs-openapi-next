{
  "name": "nestjs-openapi-next",
  "version": "12.0.2",
  "description": "A fork of @nestjs/swagger support OAS 3.2",
  "author": "undownding",
  "license": "MIT",
  "repository": "https://github.com/undownding/nestjs-openapi-next",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "import": "./dist/plugin/index.js",
      "require": "./dist/plugin/index.js",
      "default": "./dist/plugin/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier \"lib/**/*.ts\" --write",
    "lint": "eslint 'lib/**/*.ts' --fix",
    "prepublish:next": "npm run build",
    "publish:next": "npm publish --access public --tag next",
    "prepublish:npm": "npm run build",
    "publish:npm": "npm publish --access public",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:dev": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "prerelease": "npm run build",
    "release": "release-it",
    "---manual-tests---": "",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --watch --debug"
  },
  "dependencies": {
    "@microsoft/tsdoc": "0.16.0",
    "@nestjs/mapped-types": "12.0.0",
    "@standard-schema/spec": "1.1.0",
    "es-toolkit": "1.52.0",
    "js-yaml": "4.1.1",
    "path-to-regexp": "8.3.0",
    "swagger-ui-dist": "5.31.0"
  },
  "devDependencies": {
    "@commitlint/cli": "20.4.2",
    "@commitlint/config-angular": "20.4.2",
    "@eslint/eslintrc": "3.3.4",
    "@eslint/js": "10.0.1",
    "@fastify/static": "10.1.5",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/platform-fastify": "12.1.2",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.10.13",
    "@valibot/to-json-schema": "1.7.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "eslint": "10.0.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "express": "5.2.1",
    "fastify": "5.7.4",
    "globals": "17.3.0",
    "husky": "9.1.7",
    "lerna-changelog": "2.2.0",
    "lint-staged": "16.2.7",
    "openapi-types": "12.1.3",
    "prettier": "3.8.1",
    "prettier-v2": "npm:prettier@2.8.8",
    "reflect-metadata": "0.2.2",
    "release-it": "19.2.4",
    "supertest": "7.2.2",
    "swagger-parser": "10.0.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "valibot": "1.4.0",
    "vite": "8.3.2",
    "vitest": "5.0.2",
    "zod": "4.1.13",
    "zod-openapi": "5.4.6"
  },
  "peerDependencies": {
    "@fastify/static": "^8.0.0 || ^9.0.0 || ^10.0.0",
    "@nestjs/common": "^11.0.1 || ^12.0.0",
    "@nestjs/core": "^11.0.1 || ^12.0.0",
    "class-transformer": "*",
    "class-validator": "*",
    "reflect-metadata": "^0.1.12 || ^0.2.0"
  },
  "peerDependenciesMeta": {
    "@fastify/static": {
      "optional": true
    },
    "class-transformer": {
      "optional": true
    },
    "class-validator": {
      "optional": true
    }
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "git add -f"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -c .commitlintrc.json -E HUSKY_GIT_PARAMS"
    }
  },
  "changelog": {
    "labels": {
      "feature": "Features",
      "bug": "Bug fixes",
      "enhancement": "Enhancements",
      "docs": "Docs",
      "dependencies": "Dependencies",
      "type: code style": "Code style tweaks",
      "breaking change": "Breaking changes"
    }
  }
}
